# Build artefacts
*.egg-info/
build/
dist/
*.pyc

# Tool caches — nothing here belongs in a distributed artefact
__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.vulture_cache/
.coverage
htmlcov/

# Environments
.venv/
venv/
env/

# Run output
logs/
results/
*.duckdb
*.duckdb.wal

# Run outputs and data never belong in the repository. results/ (above) is
# the README's output folder; anything else a run writes should live outside
# the repo. These catch the common ones:
_dbg_*/
*.parquet
*.sas7bdat
*.csv
